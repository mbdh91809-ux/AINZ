--[[
    💥 МОБИЛЬНЫЙ ПАТЧЕР ДЛЯ ДЕЛЬТЫ (СПЕЦИАЛЬНО ДЛЯ ТЕЛЕФОНА) 💥
    Инструкция: Просто скопируй весь этот код и вставь в Executor (Delta).
    Что делает: Чинит ползунки под экран телефона и добавляет кнопку MENU!
]]

local url = "https://raw.githubusercontent.com/KimDawude/KillAura_Srcipt/main/AuraKill.lua"
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

local function CreateMobileToggleButton(targetUI)
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "MyMobileToggleUI"
    screenGui.ResetOnSpawn = false
    
    if syn and syn.protect_gui then syn.protect_gui(screenGui) end
    
    local parented = pcall(function() screenGui.Parent = CoreGui end)
    if not parented then
        screenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    end

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Name = "ToggleMenuBtn"
    toggleBtn.Size = UDim2.new(0, 55, 0, 55)
    toggleBtn.Position = UDim2.new(0, 15, 0, 120)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    toggleBtn.Text = "MENU"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.TextSize = 13
    toggleBtn.Active = true
    toggleBtn.Draggable = true
    toggleBtn.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = toggleBtn
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 255, 60)
    stroke.Thickness = 2.5
    stroke.Parent = toggleBtn

    local isMenuOpen = true
    
    toggleBtn.MouseButton1Click:Connect(function()
        if targetUI then
            isMenuOpen = not isMenuOpen
            targetUI.Enabled = isMenuOpen
            
            if isMenuOpen then
                stroke.Color = Color3.fromRGB(60, 255, 60)
            else
                stroke.Color = Color3.fromRGB(255, 60, 60)
            end
        end
    end)
end

local success, source = pcall(function()
    return game:HttpGet(url)
end)

if success and source then
    source = string.gsub(
        source, 
        "([%w_]+)%.UserInputType%s*==%s*Enum%.UserInputType%.MouseButton1", 
        "(%1.UserInputType == Enum.UserInputType.MouseButton1 or %1.UserInputType == Enum.UserInputType.Touch)"
    )
    
    source = string.gsub(
        source, 
        "([%w_]+)%.UserInputType%s*==%s*Enum%.UserInputType%.MouseMovement", 
        "(%1.UserInputType == Enum.UserInputType.MouseMovement or %1.UserInputType == Enum.UserInputType.Touch)"
    )

    local patchedScript, err = loadstring(source)
    
    if patchedScript then
        patchedScript()
        print("Скрипт успешно запущен и пропатчен под телефон!")
        
        task.wait(1.5)
        
        local foundUI = nil
        
        pcall(function()
            for _, gui in ipairs(CoreGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Name ~= "MyMobileToggleUI" and gui.Name ~= "RobloxGui" and not gui:FindFirstChild("Delta") then
                    if gui:FindFirstChildOfClass("Frame") or gui:FindFirstChild("Main") then
                        foundUI = gui
                    end
                end
            end
        end)
        
        if not foundUI then
            for _, gui in ipairs(Players.LocalPlayer.PlayerGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Name ~= "MyMobileToggleUI" then
                    if gui:FindFirstChildOfClass("Frame") or gui:FindFirstChild("Main") then
                        foundUI = gui
                    end
                end
            end
        end

        if foundUI then
            CreateMobileToggleButton(foundUI)
        else
            -- Если точное имя Gui скрыто, создаем кнопку под последнее созданное окно
            local lastGui = nil
            pcall(function()
                for _, gui in ipairs(CoreGui:GetChildren()) do
                    if gui:IsA("ScreenGui") and gui.Name ~= "MyMobileToggleUI" and gui.Name ~= "RobloxGui" then
                        lastGui = gui
                    end
                end
            end)
            if lastGui then
                CreateMobileToggleButton(lastGui)
            else
                warn("Окно не найдено.")
            end
        end
    else
        warn("Ошибка патча:", err)
    end
else
    warn("Ошибка загрузки оригинала!")
end
