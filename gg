-- مدخلات تعديل المدى والسرعة (الـ Range والـ APS)
local function createCustomInput(title, defaultVal, posY, callback)
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0, 120, 0, 20)
    Label.Position = UDim2.new(0, 20, 0, posY)
    Label.BackgroundTransparency = 1
    Label.Text = title
    Label.TextColor3 = Color3.fromRGB(180, 180, 180)
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = MainFrame

    local Box = Instance.new("TextBox")
    Box.Size = UDim2.new(0, 140, 0, 30)
    Box.Position = UDim2.new(0, 20, 0, posY + 22)
    Box.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    Box.Text = tostring(defaultVal)
    Box.TextColor3 = Color3.fromRGB(255, 255, 255)
    Box.Font = Enum.Font.Gotham
    Box.TextSize = 14
    Box.Parent = MainFrame
    Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 5)

    Box.FocusLost:Connect(function()
        local val = tonumber(Box.Text)
        if val then callback(val) end
    end)
end

createCustomInput("Aura Range (المدى):", KillAuraRange, 120, function(val) KillAuraRange = val end)
createCustomInput("Attacks / Sec (السرعة):", AttacksPerSecond, 190, function(val) AttacksPerSecond = val end)

