local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- الجداول والقوائم (الهدف والوايت ليست)
local TargetNamesList = {}
local FriendsNamesList = {}

-- الإعدادات الافتراضية المستخلصة من سكريبتك
local KillAuraEnabled = false
local KillAuraRange = 20
local AttacksPerSecond = 15

-- وظائف التحقق الذكي من القوائم
local function isTarget(name)
    if #TargetNamesList == 0 then return true end -- إذا كانت القائمة فارغة يضرب الجميع تلقائياً
    local ln = name:lower()
    for _, t in ipairs(TargetNamesList) do
        if ln:find(t, 1, true) then return true end
    end
    return false
end

local function isFriend(name)
    local ln = name:lower()
    for _, f in ipairs(FriendsNamesList) do 
        if ln:find(f, 1, true) then return true end 
    end
    return false
end

-- محرك الـ Kill Aura المستخلص والمعدل ليعمل بكفاءة وسرعة ضرب عالية
local lastAttack = 0
local killAuraConnection = nil

local function startKillAura()
    if killAuraConnection then killAuraConnection:Disconnect() end
    killAuraConnection = RunService.Heartbeat:Connect(function()
        if not KillAuraEnabled then return end
        
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        
        local now = tick()
        if now - lastAttack < (1 / AttacksPerSecond) then return end
        
        -- البحث عن أقرب هدف ينطبق عليه الشروط
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer or not plr.Character then continue end
            
            -- فحص الـ White List أولاً لحماية الأصدقاء
            if isFriend(plr.Name) or isFriend(plr.DisplayName) then continue end
            
            -- فحص الـ Target List لتحديد الهدف
            if not isTarget(plr.Name) and not isTarget(plr.DisplayName) then continue end
            
            local targetHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = plr.Character:FindFirstChildOfClass("Humanoid")
            
            if targetHRP and targetHum and targetHum.Health > 0 then
                local distance = (targetHRP.Position - myHRP.Position).Magnitude
                if distance <= KillAuraRange then
                    -- تفعيل ريموت الضرب الخاص باللعبة والموجود في سكريبتك الأصلي
                    pcall(function()
                        game:GetService("ReplicatedStorage").Packages.Knit.Services.CombatService.RF.Grab:InvokeServer()
                    end)
                    lastAttack = now
                    break -- يضرب هدف واحد في كل دورة بناءً على سرعة الـ Attacks Per Second
                end
            end
        end
    end)
end

local function stopKillAura()
    if killAuraConnection then
        killAuraConnection:Disconnect()
        killAuraConnection = nil
    end
end

