-- الكود البرمجي
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CombatServices = ReplicatedStorage:WaitForChild("OldPackages"):WaitForChild("Knit"):WaitForChild("Services"):WaitForChild("CombatService")
local GrabRF = CombatServices:WaitForChild("RF"):WaitForChild("Grab")
local BlockRE = CombatServices:WaitForChild("RE"):FindFirstChild("Block") or CombatServices:WaitForChild("RF"):FindFirstChild("Block")
local HitRF = CombatServices:WaitForChild("RF"):FindFirstChild("Hit")

local glueActive = false
local autoBlockEnabled = false
local antiRagdollEnabled = false
local isCooldown = false -- قفل الوقت الذكي
local successfullyGrabbed = false -- فلاج للتأكد من نجاح الإمساك

local function GetTarget()
    local inputText = NameInput.Text
    if inputText ~= "" then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and (string.lower(p.Name):match(string.lower(inputText)) or string.lower(p.DisplayName):match(string.lower(inputText))) then
                return p
            end
        end
    end
    return nil
end

-- تحديث نص الحالة
task.spawn(function()
    while task.wait(0.1) do
        local p = GetTarget()
        if p then 
            if isCooldown then
                TargetLabel.Text = "⚡ انتهاء الـ Grab.. في فترة الانتظار"
                TargetLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
            elseif glueActive then
                TargetLabel.Text = "🎯 جاري محاولة الإمساك بـ: " .. p.DisplayName
                TargetLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
            else
                TargetLabel.Text = "جاهز للانقضاض خلف: " .. p.DisplayName 
                TargetLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
            end
        else 
            TargetLabel.Text = "اكتب اسم الهاكر بالظبط!" 
            TargetLabel.TextColor3 = Color3.fromRGB(255, 150, 50) 
        end
    end
end)

-- [1] حلقة التثبيت الفيزيائي (الالتصاق كشنطة في الضهر)
RunService.RenderStepped:Connect(function()
    if glueActive and not isCooldown then
        local targetPlayer = GetTarget()
        if targetPlayer and targetPlayer.Character and LocalPlayer.Character then
            local myHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            
            if myHRP and targetHRP then
                -- إلغاء قوى الارتداد تماماً لتجنب الـ Rubberbanding
                myHRP.AssemblyLinearVelocity = targetHRP.AssemblyLinearVelocity
                myHRP.AssemblyAngularVelocity = targetHRP.AssemblyAngularVelocity
                
                -- التوجيه والنظر مع شاشة الخصم
                local targetLookVector = targetHRP.CFrame.LookVector
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + targetLookVector)
                
                -- تثبيتك خلف ظهره مباشرة بـ 0.5 متر كأنه يرتديك كحقيبة
                myHRP.CFrame = (targetHRP.CFrame * CFrame.new(0, 0, 0.5))
            end
        end
    end
end)

-- [2] حلقة الـ Grab الذكية (سبام حتى يمسك، والوقت يبدأ بعد الإمساك)
task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if glueActive and not isCooldown then
            local targetPlayer = GetTarget()
            if targetPlayer and targetPlayer.Character then
                -- سبام سريع جداً للمسكة بدون انتظار
                task.spawn(function()
                    local success, result = pcall(function() 
                        return GrabRF:InvokeServer(targetPlayer.Character) 
                    end)
                    
                    -- إذا السيرفر رجع استجابة تفيد بأن اللاعب تم إمساكه بنجاح
                    if success and not successfullyGrabbed then
                        successfullyGrabbed = true
                        glueActive = false -- إيقاف السبام فوراً
                        isCooldown = true -- تفعيل وقت الانتظار الآن!
                        
                        -- تحديث شكل الزرار
                        GlueToggle.Text = "فترة الانتظار (WAIT)"
                        GlueToggle.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
                        GlueToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
                        
                        -- انتظر حتى ينتهي الأنيميشن أو مدة الـ Grab في اللعبة
                        task.wait(1.8) 
                        
                        -- إعادة تصفير الحالة للضغطة القادمة
                        isCooldown = false
                        successfullyGrabbed = false
                        GlueToggle.Text = "وضع الوميض: واقف (OFF)"
                        GlueToggle.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
                        GlueToggle.TextColor3 = Color3.fromRGB(255, 85, 85)
                    end
                end)
                
                -- سبام ضربات متزامن
                if HitRF then
                    task.spawn(function() pcall(function() HitRF:InvokeServer(targetPlayer.Character) end) end)
                end
            end
        end
    end
end)

-- تشغيل وإيقاف الوضع يدوياً
function ToggleGlue()
    if isCooldown then return end -- منع التشغيل لو في فترة الانتظار بعد مسكة ناجحة

    glueActive = not glueActive
    if glueActive then
        successfullyGrabbed = false
        GlueToggle.Text = "جاري الالتصاق والمسك... ⚡"
        GlueToggle.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
        GlueToggle.TextColor3 = Color3.fromRGB(0,0,0)
    else
        GlueToggle.Text = "وضع الوميض: واقف (OFF)"
        GlueToggle.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
        GlueToggle.TextColor3 = Color3.fromRGB(255, 85, 85)
    end
end
GlueToggle.MouseButton1Click:Connect(ToggleGlue)

-- البلوك التلقائي
local function FireBlockRemote(state)
    if BlockRE then
        if BlockRE:IsA("RemoteFunction") then task.spawn(function() BlockRE:InvokeServer(state) end) else BlockRE:FireServer(state) end
    end
end

BlockToggle.MouseButton1Click:Connect(function()
    autoBlockEnabled = not autoBlockEnabled
    if autoBlockEnabled then
        BlockToggle.Text = "Auto Block: ON" BlockToggle.BackgroundColor3 = Color3.fromRGB(85, 255, 85) BlockToggle.TextColor3 = Color3.fromRGB(0,0,0)
    else
        BlockToggle.Text = "Auto Block: OFF" BlockToggle.BackgroundColor3 = Color3.fromRGB(35, 35, 40) BlockToggle.TextColor3 = Color3.fromRGB(255, 85, 85)
        FireBlockRemote(false)
    end
end)
task.spawn(function() while task.wait(0.05) do if autoBlockEnabled then FireBlockRemote(true) end end end)

-- الـ Anti Ragdoll
RagdollToggle.MouseButton1Click:Connect(function()
antiRagdollEnabled = not antiRagdollEnabled
    if antiRagdollEnabled then
        RagdollToggle.Text = "Anti Ragdoll: ON" RagdollToggle.BackgroundColor3 = Color3.fromRGB(85, 255, 85) RagdollToggle.TextColor3 = Color3.fromRGB(0,0,0)
    else
        RagdollToggle.Text = "Anti Ragdoll: OFF" RagdollToggle.BackgroundColor3 = Color3.fromRGB(35, 35, 40) RagdollToggle.TextColor3 = Color3.fromRGB(255, 85, 85)
    end
end)
task.spawn(function()
    while task.wait(0.02) do
        if antiRagdollEnabled and LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstOfClass("Humanoid")
            if hum then
                if hum.PlatformStand == true then hum.PlatformStand = false end
                local state = hum:GetState()
                if state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.Physics then
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end
        end
    end
end)

-- الاختصارات
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    local currentGlueKey = GlueBindInput.Text:upper()
    if currentGlueKey ~= "" and input.KeyCode == Enum.KeyCode[currentGlueKey] then 
        ToggleGlue() 
    end
end)
